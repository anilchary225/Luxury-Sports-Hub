# SMTP settings
# Gmail example: smtp.gmail.com / 465 / true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-gmail-app-password

# Email address that receives registration/enquiry notifications
MAIL_TO=info@zenithh.in

# Existing protected Excel download endpoint
ADMIN_DOWNLOAD_SECRET=zenithh-download-secret
